# Argus API · 环境变量模板
# 复制本文件为 .env 并填入真值：cp .env.example .env
# .env 入 .gitignore，永不提交。

# ── 运行时 ──────────────────────────────────────────────────
APP_ENV=dev                   # dev | test | prod
DEBUG=false                   # dev 设 true，prod 必 false
API_HOST=127.0.0.1
API_PORT=8000

# ── 数据库 ──────────────────────────────────────────────────
# 默认 SQLite 不需要 Docker；切真 Postgres：
# DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
DATABASE_URL=sqlite+aiosqlite:///./argus.db

# ── Redis ───────────────────────────────────────────────────
# memory:// 用 fakeredis 内存版；切真 Redis：
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=memory://

# ── OAuth (GitHub) ──────────────────────────────────────────
# 注册：https://github.com/settings/applications/new
# Callback URL 必须与下方 GITHUB_OAUTH_CALLBACK_URL 一致
GITHUB_OAUTH_CLIENT_ID=<your-github-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<your-github-oauth-client-secret>
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# ── JWT / Session ────────────────────────────────────────────
# argus 自己的登录票据。必须与 OAuth secret 独立——泄露后果不同。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<your-jwt-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=604800       # 7 天
# dev 走 http://localhost，Secure cookie 浏览器不发；生产部署改true
COOKIE_SECURE=false
# 登录成功后送回前端的地址
FRONTEND_BASE_URL=http://localhost:3000

# ── LLM（接中转站示例，argus 默认走 Anthropic 官方）────────────────
# ① 直连 Anthropic 官方（推荐）：ANTHROPIC_BASE_URL 留空即可
# ② 用第三方中转站：填 base_url 并确认 model alias 在中转站能识别
#    已知可用：ANTHROPIC_BASE_URL=https://llmapi.pro
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=<your-anthropic-key-or-relay-key>
# ③ Embedding 用 OpenAI text-embedding-3-small
OPENAI_API_KEY=<your-openai-key>

# Tavily 联网搜索（agent 的 tavily_search 工具）。申请：https://tavily.com
# 留空不影响服务启动——工具会返回错误字符串给模型，agent 照常跑完，只是搜不到东西。
TAVILY_API_KEY=<your-tavily-key>

# 复杂任务 model（Supervisor / Researcher / Writer）
ANTHROPIC_COMPLEX_MODEL=claude-sonnet-5
# 简单任务 model（Analyst / Critic / Summarizer）
# ⚠ Haiku 4.5 在 2026-10-15 退役，到期必须升 Haiku 5
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

# 按 agent 路由的可选覆盖（留空退到 complex/default）
ANTHROPIC_SUPERVISOR_MODEL=
ANTHROPIC_RESEARCHER_MODEL=
ANTHROPIC_WRITER_MODEL=
ANTHROPIC_ANALYST_MODEL=
ANTHROPIC_CRITIC_MODEL=
ANTHROPIC_SUMMARIZER_MODEL=
